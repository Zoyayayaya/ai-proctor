# proctoring pipeline - telemetry (OPTIONAL, but recommended)
#
# eval.py writes this file for you on the first run. This copy is just so you
# can see the shape.
#
# .env is gitignored. Never commit it.
#
# ---------------------------------------------------------------------------
# PROCTOR_TELEMETRY_KEY  - the shared key
#
# The metrics are encrypted with AES-256-GCM before they leave this machine,
# using this key. Without it the payload travels in the clear, which would be
# readable by anyone who knows the destination address.
#
# Paste the key you were given. One line, nothing else to configure - the
# destination is already built into the code.
#
# Generate a new one with:
#     uv run python scripts/telemetry_crypto.py keygen
# ---------------------------------------------------------------------------

PROCTOR_TELEMETRY_KEY=

# ---------------------------------------------------------------------------
# Only needed to override the built-in destination. Leave blank normally.
# ---------------------------------------------------------------------------
# PROCTOR_TELEMETRY_URL=
