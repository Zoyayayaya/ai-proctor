# proctoring pipeline - outbound telemetry (OPTIONAL)
#
# Copy to .env and fill in, or let eval.py --telemetry-setup write it for you.
# .env is gitignored - never commit it.
#
# What gets sent: metrics and environment metadata only.
# Never sent: video, frames, the per-frame feature table, filenames, paths.

PROCTOR_TELEMETRY_URL=
PROCTOR_TELEMETRY_TOKEN=
